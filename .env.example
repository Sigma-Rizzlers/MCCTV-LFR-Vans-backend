# PostgreSQL connection string (asyncpg dialect)
# For Supabase: use the Supavisor transaction-mode pooler URL (port 6543)
# URL-encode special characters in the password: @ -> %40, & -> %26, % -> %25
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres?ssl=require

# Secret key for signing auth tokens — generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Auth token lifetime in minutes (default: 60)
# Tokens are automatically deleted from the DB after this period.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Set to "development" to allow localhost CORS origins.
# Leave as "production" (or unset) on Railway and any live deployment.
ENVIRONMENT=production
